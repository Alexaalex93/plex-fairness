{
  "title": "Plex - Justicia del reparto",
  "uid": "plex-fairness",
  "timezone": "Europe/Madrid",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "plex"
  ],
  "templating": {
    "list": [
      {
        "name": "poll",
        "type": "constant",
        "query": "30",
        "hide": 2,
        "label": "Segundos entre muestreos"
      },
      {
        "name": "jain_threshold",
        "type": "custom",
        "query": "0.6,0.7,0.8,0.9",
        "label": "Umbral Jain",
        "current": {
          "text": "0.8",
          "value": "0.8"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Justicia del reparto (índice de Jain)",
      "description": "1 = todos reciben lo mismo. 'Calidad' compara la calidad servida frente a la original de cada uno; es la métrica buena. Solo se calcula con 2+ personas reproduciendo.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), avg(jain_quality) AS \"Jain calidad\", avg(jain_bandwidth) AS \"Jain ancho de banda\"\nFROM poll WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ancho de banda por usuario",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), user_name AS metric, avg(bandwidth_kbps)/1000.0 AS value\nFROM session_sample WHERE $__timeFilter(ts) AND state = 'playing'\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Calidad servida / original por usuario",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), user_name AS metric, avg(quality_ratio) AS value\nFROM session_sample WHERE $__timeFilter(ts) AND state = 'playing'\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Velocidad de transcode (<1 = cortes)",
      "description": "Mínimo por minuto. Por debajo de 1x Plex no llega a tiempo y el cliente se queda cargando.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), user_name AS metric, min(transcode_speed) AS value\nFROM session_sample WHERE $__timeFilter(ts) AND state = 'playing' AND transcode_speed IS NOT NULL\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU (RTX 2060) vs transcodes",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), avg(gpu_enc_util) AS \"NVENC %\", avg(gpu_dec_util) AS \"NVDEC %\",\n  avg(gpu_util) AS \"GPU %\", max(transcodes) AS \"Transcodes\", max(playing) AS \"Reproduciendo\"\nFROM poll WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lectura por disco del array",
      "description": "Si dos streams leen del mismo disco compiten entre sí: el array de Unraid no reparte los datos entre discos.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), disk AS metric, avg(read_mbps) AS value\nFROM disk_sample WHERE $__timeFilter(ts) GROUP BY 1, 2 HAVING max(read_mbps) > 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MBs",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Streams simultáneos por disco",
      "description": "Disco donde está el fichero de cada stream (atributo system.LOCATION de Unraid).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), coalesce(disk, '?') AS metric, max(n) AS value FROM (\n  SELECT ts, disk, count(*) AS n FROM session_sample\n  WHERE $__timeFilter(ts) AND state = 'playing' GROUP BY ts, disk) x\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Resumen por usuario",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.user_name AS \"Usuario\",\n  round(count(*) * $poll / 3600.0, 1) AS \"Horas\",\n  round(100.0 * avg(CASE WHEN s.video_decision = 'transcode' THEN 1 ELSE 0 END), 1) AS \"% transcode\",\n  round(avg(s.quality_ratio)::numeric, 2) AS \"Calidad media\",\n  round(100.0 * avg(CASE WHEN s.transcode_speed < 1 THEN 1 ELSE 0 END), 1) AS \"% transcode lento\",\n  round(avg(s.bandwidth_kbps) / 1000.0, 1) AS \"Mbps medio\",\n  (SELECT count(*) FROM buffer_event b WHERE b.user_name = s.user_name AND $__timeFilter(b.ts)) AS \"Buffers\"\nFROM session_sample s WHERE $__timeFilter(s.ts) AND s.state = 'playing'\nGROUP BY s.user_name ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "table",
      "title": "Momentos injustos (Jain < umbral)",
      "description": "Cada fila es un muestreo en el que el reparto fue malo; el detalle muestra % de calidad, decisión y velocidad de transcode de cada usuario.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.ts AS \"Momento\", p.playing AS \"Reproduciendo\", round(p.jain_quality::numeric, 2) AS \"Jain\",\n  round(p.gpu_enc_util::numeric) AS \"NVENC %\",\n  string_agg(s.user_name || ' ' || round(100 * coalesce(s.quality_ratio, 0))::text || '% '\n             || coalesce(s.video_decision, '') || coalesce(' x' || s.transcode_speed::text, ''), ' | ' ORDER BY s.quality_ratio) AS \"Detalle\"\nFROM poll p JOIN session_sample s ON s.ts = p.ts AND s.state = 'playing'\nWHERE $__timeFilter(p.ts) AND p.jain_quality < $jain_threshold\nGROUP BY p.ts, p.playing, p.jain_quality, p.gpu_enc_util ORDER BY p.ts DESC LIMIT 300"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "table",
      "title": "Concurrencia media por día y hora",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 14,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lpad(h::text, 2, '0') || 'h' AS \"Hora\",\n  round(avg(playing) FILTER (WHERE d = 1), 2) AS \"Lun\", round(avg(playing) FILTER (WHERE d = 2), 2) AS \"Mar\",\n  round(avg(playing) FILTER (WHERE d = 3), 2) AS \"Mié\", round(avg(playing) FILTER (WHERE d = 4), 2) AS \"Jue\",\n  round(avg(playing) FILTER (WHERE d = 5), 2) AS \"Vie\", round(avg(playing) FILTER (WHERE d = 6), 2) AS \"Sáb\",\n  round(avg(playing) FILTER (WHERE d = 7), 2) AS \"Dom\", max(playing) AS \"Pico\"\nFROM (SELECT extract(isodow FROM ts AT TIME ZONE 'Europe/Madrid')::int AS d, extract(hour FROM ts AT TIME ZONE 'Europe/Madrid')::int AS h, playing\n      FROM poll WHERE $__timeFilter(ts)) x\nGROUP BY h ORDER BY h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "color-background",
              "mode": "gradient"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "table",
      "title": "Eventos de buffer",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "plexfair"
      },
      "gridPos": {
        "x": 14,
        "y": 53,
        "w": 10,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "plexfair"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"Momento\", user_name AS \"Usuario\", title AS \"Título\" FROM buffer_event\nWHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}